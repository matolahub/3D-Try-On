{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "frontend-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev:phone", "--", "--port", "5180", "--strictPort"],
      "port": 5180,
      "url": "https://localhost:5180"
    },
    {
      "name": "demo-shop",
      "runtimeExecutable": "node",
      "runtimeArgs": ["frontend/demo-shop/serve.mjs"],
      "port": 5174
    }
  ]
}
